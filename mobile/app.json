{
  "expo": {
    "name": "The Villages Everything App",
    "slug": "the-villages-everything-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "villageseverything",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c4a6e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thevillageseverythingapp.app",
      "buildNumber": "6",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access so you can take photos for Best of the Month, Support Local, Marketplace, and member uploads.",
        "NSPhotoLibraryUsageDescription": "Allow photo library access so you can upload pictures for Best of the Month, Support Local, Marketplace, and member content.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving photos you capture in the app.",
        "NSMicrophoneUsageDescription": "Allow microphone access if you record short videos for community listings.",
        "NSLocationWhenInUseUsageDescription": "Your location is used for the Holiday Light Tour driving route and for nearby village features when you allow it.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thevillageseverythingapp.app",
      "versionCode": 10,
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "backgroundColor": "#0c4a6e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-iap",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used for the Holiday Light Tour driving route and for nearby village features when you allow it.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "adf75ad3-f911-44ca-acba-5dd843b23eb7"
      },
      "siteUrl": "https://www.thevillageseverythingapp.com"
    },
    "owner": "the-villages-everything-app"
  }
}
