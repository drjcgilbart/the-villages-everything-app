{
  "headers": [
    {
      "source": "/golf-cart-hero",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/golf-cart-hero/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/real-estate/refresh",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/real-estate/youtube-refresh",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/videos/youtube-refresh",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/entertainment/refresh",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/calendar/refresh",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/best-of-month/tabulate",
      "schedule": "15 5 1 * *"
    }
  ]
}
