# Password for /admin (change this before deploying!)
ADMIN_PASSWORD=changeme

# Optional extra secret used to sign the admin cookie
ADMIN_SECRET=pick-a-long-random-string

# Shared beta unlock password (used when the admin “Site access” wall is ON).
# Keep this set even when the site is public so you can re-enable the wall from Admin
# without changing env. The wall is OFF by default; toggle it in Admin → Site access.
SITE_PASSWORD=

# Optional emergency override for the beta wall (skips admin toggle):
# on | true | 1  → force wall on (still needs SITE_PASSWORD)
# off | false | 0 → force wall off
# SITE_GATE_ENABLED=

# Public site URL (for metadata / production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SpaceXAI / xAI — My Space Health “My Day” recaps (server-side only)
# https://console.x.ai — leave empty to use the built-in local writer
# XAI_API_KEY=

# Email the host when someone submits anything for approval,
# and send a welcome letter when you approve a member.
# Free Resend key: https://resend.com — verify thevillageseverythingapp.com
# so mail can come From admin@ or noreply@ on that domain.
ADMIN_NOTIFY_EMAIL=admin@thevillageseverythingapp.com
# ADMIN_NOTIFY_FROM=The Villages Everything App <admin@thevillageseverythingapp.com>
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# --- Durable storage on Vercel (Admin members, dining, yard sale, etc.) ---
# Prefer free Upstash Redis when Vercel Blob Hobby is over quota:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx
# Optional: Vercel Blob (auto-added when you create a Blob store)
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# --- Merch shop (/shop) ---
# Checkout turns on by itself when STRIPE_SECRET_KEY is set (same key as memberships and tips).
# Without it, the cart shows "Checkout is temporarily unavailable". Optional kill switch:
# SHOP_CHECKOUT_ENABLED=false
# Local test mode (no Stripe call, no charge, no Printful order; ignored on Vercel production):
# SHOP_CHECKOUT_MOCK=true
# Shop orders are fulfilled from the existing /api/stripe/webhook (or the optional /api/shop/stripe-webhook)
# and again from /shop/success. Optional signing secret for the dedicated shop endpoint:
# SHOP_STRIPE_WEBHOOK_SECRET=
# Printful private token. Per-SKU sync variant ids live in src/lib/shop/printful-variants.ts.
# Missing key or ids: the paid order is saved (Redis or .data/shop-orders.json) and the admin is emailed.
# PRINTFUL_API_KEY=
# PRINTFUL_STORE_ID=
# false = orders land in Printful as drafts you confirm by hand; true = auto-submit for fulfillment
# PRINTFUL_AUTO_CONFIRM=false
# Secret ?key= for /api/shop/printful-webhook (Printful v1 webhooks are unsigned)
# PRINTFUL_WEBHOOK_SECRET=
# SHIPPING_RATE_CENTS=599
# SHIP_COUNTRIES=US
# STRIPE_AUTOMATIC_TAX=false
