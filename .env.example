# Password for /admin (change this before deploying!)
ADMIN_PASSWORD=changeme

# Optional extra secret used to sign the admin cookie
ADMIN_SECRET=pick-a-long-random-string

# Site-wide beta gate (leave empty or omit to make the site public)
# When set, visitors must enter this password once per browser at /beta-gate
SITE_PASSWORD=

# Optional separate secret for signing the beta unlock cookie
# (falls back to ADMIN_SECRET, then SITE_PASSWORD)
# SITE_GATE_SECRET=another-long-random-string

# Public site URL (for metadata / production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
