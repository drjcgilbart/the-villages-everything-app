  "interviews": [
    {
      "id": "int-seed-1",
      "restaurantId": "rest-seed-5",
      "personName": "Chef Angela Ruiz",
      "role": "Executive Chef",
      "title": "How Gulf & Green Sources a “Local” Catch",
      "excerpt": "On specials boards, supplier relationships, and why grouper night sells out.",
      "quote": "If it isn't tasting like the Gulf, it doesn't hit the plate.",
      "body": "We run a tight specials board because the fish decides the menu — not the other way around.\n\nVillagers know quality. They'll tell you if the oysters aren't singing. My favorite nights are when someone stops by the pass just to say the grouper reminded them of a trip to Cedar Key.\n\nRetirement dining doesn't mean boring dining. It means we get to cook for people who have time to taste.",
      "publishedAt": "2026-08-02T11:03:31.423Z",
      "featured": true
    },
    {
      "id": "int-seed-2",
      "restaurantId": "rest-seed-2",
      "personName": "Marco Bellini",
      "role": "Owner & Dough Whisperer",
      "title": "Cart Path Pizza: Built for the 9 a.m. Lunch Rush",
      "excerpt": "Why takeout bags matter as much as the pie — and the secret to garlic knots.",
      "quote": "If it survives a cart ride home, it's pizza done right.",
      "body": "We designed the menu for people in a hurry between pickleball and grandkid pickup.\n\nThe dough is overnight. The knots are non-negotiable. And yes, we keep extra napkins by the door because the “I'll just have one slice in the cart” plan never works.",
      "publishedAt": "2026-07-30T11:03:31.423Z",
      "featured": true
    },
    {
      "id": "int-seed-3",
      "restaurantId": "rest-seed-7",
      "personName": "Dee Patel",
      "role": "General Manager",
      "title": "Sunrise Skillet: Winning the Early Crowd",
      "excerpt": "Coffee cadence, regulars by name, and the pancake that started a fan club.",
      "quote": "Breakfast is a community sport around here.",
      "body": "Our regulars arrive like clockwork. Some want quiet. Some want gossip. Everyone wants coffee that doesn't quit.\n\nThe blueberry pancakes weren't supposed to be famous — but try telling that to the table that ordered three stacks “for research.”",
      "publishedAt": "2026-07-27T11:03:31.423Z",
      "featured": false
    }
  ],
  "updatedAt": "2026-08-05T11:03:31.422Z"
